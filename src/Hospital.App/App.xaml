<Application x:Class="Hospital.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Hospital.App.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Global converters -->
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
            <conv:BoolToInverseConverter x:Key="BoolToInverseConverter" />
            <conv:DrugDisplayConverter x:Key="DrugDisplayConverter" />
            <conv:SelectionDisplayConverter x:Key="SelectionDisplayConverter" />
            <!-- ================================================================== -->
            <!-- DESIGN TOKENS — 遵循 DESIGN.md 色板定义                          -->
            <!-- ================================================================== -->

            <!-- Primary palette — Teal (医疗青绿) -->
            <SolidColorBrush x:Key="BlueDeepBrush" Color="#0F766E" />
            <SolidColorBrush x:Key="BluePrimaryBrush" Color="#14B8A6" />
            <SolidColorBrush x:Key="BlueHoverBrush" Color="#0D9488" />
            <SolidColorBrush x:Key="BlueLightBrush" Color="#2DD4BF" />
            <SolidColorBrush x:Key="BlueTintBrush" Color="#99F6E4" />
            <SolidColorBrush x:Key="BlueSubtleBrush" Color="#CCFBF1" />
            <SolidColorBrush x:Key="BlueAccentBrush" Color="#CCFBF1" />

            <!-- Neutral palette -->
            <SolidColorBrush x:Key="Gray900Brush" Color="#111827" />
            <SolidColorBrush x:Key="Gray700Brush" Color="#374151" />
            <SolidColorBrush x:Key="Gray500Brush" Color="#6B7280" />
            <SolidColorBrush x:Key="Gray400Brush" Color="#9CA3AF" />
            <SolidColorBrush x:Key="Gray300Brush" Color="#D1D5DB" />
            <SolidColorBrush x:Key="Gray200Brush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="Gray100Brush" Color="#F3F4F6" />
            <SolidColorBrush x:Key="Gray50Brush" Color="#F0F2F5" />
            <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF" />

            <!-- Semantic palette -->
            <SolidColorBrush x:Key="Green600Brush" Color="#059669" />
            <SolidColorBrush x:Key="Green200Brush" Color="#A7F3D0" />
            <SolidColorBrush x:Key="Green50Brush" Color="#F0FDF4" />
            <SolidColorBrush x:Key="Green800Brush" Color="#166534" />
            <SolidColorBrush x:Key="Amber600Brush" Color="#D97706" />
            <SolidColorBrush x:Key="Red700Brush" Color="#B91C1C" />
            <SolidColorBrush x:Key="Red50Brush" Color="#FEF2F2" />
            <SolidColorBrush x:Key="Red200Brush" Color="#FECACA" />
            <SolidColorBrush x:Key="Red800Brush" Color="#991B1B" />

            <!-- Navigation specific -->
            <SolidColorBrush x:Key="NavTextBrush" Color="#CCFBF1" />
            <SolidColorBrush x:Key="NavTextSelectedBrush" Color="#FFFFFF" />

            <!-- ================================================================== -->
            <!-- SHARED EFFECTS                                                      -->
            <!-- ================================================================== -->

            <DropShadowEffect x:Key="CardShadowEffect"
                              BlurRadius="24"
                              Direction="270"
                              Opacity="0.12"
                              ShadowDepth="4"
                              Color="#000000" />

            <!-- ================================================================== -->
            <!-- SHARED STYLES                                                       -->
            <!-- ================================================================== -->

            <!-- Form label -->
            <Style x:Key="FormLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Gray700Brush}" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <!-- Text input -->
            <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="MinWidth" Value="300" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BluePrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Text input with watermark placeholder (Tag = 占位提示) -->
            <Style x:Key="WatermarkTextBoxStyle" TargetType="TextBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Grid>
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="6">
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="watermark"
                                           Margin="{TemplateBinding Padding}"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource Gray400Brush}"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter TargetName="watermark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BluePrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Password input -->
            <Style x:Key="FormPasswordBoxStyle" TargetType="PasswordBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="MinWidth" Value="300" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                    </Trigger>
                    <Trigger Property="IsFocused" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource BluePrimaryBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Primary button -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Background" Value="{StaticResource BluePrimaryBrush}" />
                <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BlueHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BlueDeepBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource BlueTintBrush}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Secondary button -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="40" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource Gray700Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Gray100Brush}" />
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource Gray200Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Quick-select chip (small pill) -->
            <Style x:Key="ChipButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                <Setter Property="Height" Value="30" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="Medium" />
            </Style>

            <!-- ================================================================== -->
            <!-- Dropdown (ComboBox) — 圆角边框 + 青色箭头 + 阴影浮层，全局统一       -->
            <!-- ================================================================== -->

            <!-- 下拉项：hover 高亮、选中态着色 -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bd" Background="Transparent"
                                    Padding="{TemplateBinding Padding}"
                                    CornerRadius="4" Margin="3,1">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BlueSubtleBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource BluePrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BlueTintBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource BlueDeepBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 下拉框本体（隐式样式，作用于全局所有 ComboBox） -->
            <Style TargetType="ComboBox">
                <Setter Property="Height" Value="38" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinWidth" Value="120" />
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Gray300Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <!-- 触发区：圆角边框 + 右侧箭头 -->
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Background="{TemplateBinding Background}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                <Path x:Name="arrow"
                                                      Data="M 0,0 L 4,4 L 8,0 Z"
                                                      Fill="{StaticResource Gray500Brush}"
                                                      Width="10" Height="5" Stretch="Uniform"
                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                      Margin="0,0,14,0" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BluePrimaryBrush}" />
                                                    <Setter TargetName="arrow" Property="Fill" Value="{StaticResource BluePrimaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <!-- 当前选中项展示（不可命中，点击落到 ToggleButton 上） -->
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <!-- 同时支持 ItemTemplate（走 ItemTemplate 渲染）与 DisplayMemberPath（取成员属性文本） -->
                                    <ContentPresenter.Content>
                                        <MultiBinding Converter="{StaticResource SelectionDisplayConverter}">
                                            <Binding Path="SelectedItem" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="DisplayMemberPath" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </ContentPresenter.Content>
                                    <ContentPresenter.ContentTemplate>
                                        <Binding Path="ItemTemplate" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>

                                <!-- 未选中时的占位提示（Tag = 占位文本） -->
                                <TextBlock x:Name="watermark"
                                           IsHitTestVisible="False"
                                           Margin="{TemplateBinding Padding}"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{StaticResource Gray400Brush}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />

                                <!-- 下拉浮层 -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True"
                                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       Placement="Bottom"
                                       PopupAnimation="Fade"
                                       StaysOpen="False">
                                    <Border Background="{StaticResource WhiteBrush}"
                                            BorderBrush="{StaticResource Gray200Brush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#111827" />
                                        </Border.Effect>
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" Padding="3">
                                            <ScrollViewer.Resources>
                                                <!-- 下拉内细滚动条 -->
                                                <Style TargetType="ScrollBar">
                                                    <Setter Property="Width" Value="8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ScrollBar">
                                                                <Grid Background="Transparent">
                                                                    <Track x:Name="PART_Track"
                                                                           Orientation="{TemplateBinding Orientation}"
                                                                           IsDirectionReversed="True">
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.Thumb>
                                                                            <Thumb>
                                                                                <Thumb.Template>
                                                                                    <ControlTemplate TargetType="Thumb">
                                                                                        <Border x:Name="thumb"
                                                                                                Background="{StaticResource Gray300Brush}"
                                                                                                CornerRadius="4" Margin="1" />
                                                                                        <ControlTemplate.Triggers>
                                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                                <Setter TargetName="thumb" Property="Background" Value="{StaticResource Gray400Brush}" />
                                                                                            </Trigger>
                                                                                        </ControlTemplate.Triggers>
                                                                                    </ControlTemplate>
                                                                                </Thumb.Template>
                                                                            </Thumb>
                                                                        </Track.Thumb>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                                                                        </Track.IncreaseRepeatButton>
                                                                    </Track>
                                                                </Grid>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ScrollViewer.Resources>
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SelectionBoxItem" Value="{x:Null}">
                                    <Setter TargetName="watermark" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ================================================================== -->
            <!-- DatePicker / Calendar — 日期选择，圆角输入 + 青色日历浮层           -->
            <!-- ================================================================== -->

            <!-- 日期输入框（DatePicker 的文本部分） -->
            <Style TargetType="DatePickerTextBox">
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="CaretBrush" Value="{StaticResource BluePrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePickerTextBox">
                            <Border x:Name="border"
                                    Background="{StaticResource WhiteBrush}"
                                    BorderBrush="{StaticResource Gray300Brush}"
                                    BorderThickness="1"
                                    CornerRadius="6,0,0,6">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="12,0" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource Gray400Brush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource BluePrimaryBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 日历：白色圆角卡片包裹 -->
            <Style TargetType="Calendar">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Calendar">
                            <Border Background="{StaticResource WhiteBrush}" Padding="4">
                                <CalendarItem x:Name="PART_CalendarItem" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 日历头部导航（上/下月 + 月份标题） -->
            <Style TargetType="CalendarItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarItem">
                            <ControlTemplate.Resources>
                                <DataTemplate x:Key="DayTitleTemplate">
                                    <TextBlock FontWeight="SemiBold" FontSize="11"
                                               Foreground="{StaticResource Gray500Brush}"
                                               Margin="0,6,0,6" Text="{Binding}"
                                               HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ControlTemplate.Resources>
                            <Grid x:Name="PART_Root" Background="{StaticResource WhiteBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Control x:Name="PART_Header" Grid.Row="0">
                                    <Control.Template>
                                        <ControlTemplate TargetType="Control">
                                            <Border Background="Transparent">
                                                <Grid Margin="4,6,4,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                                            Width="28" Height="28" IsTabStop="False" Focusable="False"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                                    <Path Data="M 13,6 L 7,12 L 13,18"
                                                                          Stroke="{StaticResource Gray500Brush}" StrokeThickness="1.6"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Gray100Brush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.3" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                                            Height="28" IsTabStop="False" Focusable="False"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                            FontSize="13" FontWeight="SemiBold"
                                                            Foreground="{StaticResource Gray900Brush}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Gray100Brush}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <Button x:Name="PART_NextButton" Grid.Column="2"
                                                            Width="28" Height="28" IsTabStop="False" Focusable="False"
                                                            Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bd" Background="Transparent" CornerRadius="6">
                                                                    <Path Data="M 11,6 L 17,12 L 11,18"
                                                                          Stroke="{StaticResource Gray500Brush}" StrokeThickness="1.6"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="bd" Property="Background" Value="{StaticResource Gray100Brush}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsEnabled" Value="False">
                                                                        <Setter TargetName="bd" Property="Opacity" Value="0.3" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Control.Template>
                                </Control>
                                <!-- 星期表头 + 日期网格（7 行 × 7 列：首行星期，后 6 行日期） -->
                                <UniformGrid x:Name="PART_CalendarBody" Grid.Row="1" Rows="7" Columns="7"
                                             Margin="4,4,4,6" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 日期单元格：hover/选中 青色 -->
            <Style TargetType="CalendarDayButton">
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Grid>
                                <Border x:Name="bd" Background="Transparent" CornerRadius="6" Margin="1"
                                        BorderBrush="Transparent" BorderThickness="1">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BlueSubtleBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BluePrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                </Trigger>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource BluePrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Gray400Brush}" />
                                </Trigger>
                                <Trigger Property="IsBlackedOut" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource Gray100Brush}" />
                                    <Setter Property="Foreground" Value="{StaticResource Gray400Brush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 年/月导航单元格 -->
            <Style TargetType="CalendarButton">
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarButton">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                    Margin="1" Padding="10,6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BlueSubtleBrush}" />
                                </Trigger>
                                <Trigger Property="HasSelectedDays" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{StaticResource BluePrimaryBrush}" />
                                    <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 日期选择器本体（隐式样式，作用于全局所有 DatePicker） -->
            <Style TargetType="DatePicker">
                <Setter Property="Height" Value="38" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="MinWidth" Value="140" />
                <Setter Property="Foreground" Value="{StaticResource Gray900Brush}" />
                <Setter Property="IsTodayHighlighted" Value="True" />
                <Setter Property="SelectedDateFormat" Value="Short" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DatePicker">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 日期文本输入 -->
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   BorderBrush="{StaticResource Gray300Brush}"
                                                   BorderThickness="1"
                                                   FontSize="{TemplateBinding FontSize}"
                                                   Foreground="{TemplateBinding Foreground}" />
                                <!-- 展开日历的触发按钮：独立占第 1 列、叠在文字框之上，确保整块可点。
                                     注意：必须声明在 TextBox 之后（z-order 更高），否则会被溢出的文字框盖住 -->
                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Width="46" VerticalAlignment="Stretch"
                                        IsTabStop="False" Focusable="False" ClickMode="Press"
                                        Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- 日历图标按钮：常显青色，一眼可辨为日期选择器 -->
                                            <Border x:Name="iconBorder"
                                                    Background="{StaticResource BlueSubtleBrush}"
                                                    CornerRadius="0,6,6,0"
                                                    BorderBrush="{StaticResource Gray300Brush}"
                                                    BorderThickness="1">
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Path x:Name="icon"
                                                          Data="M 4,1 V 3 M 12,1 V 3 M 2,5 H 14 V 14 H 2 Z M 2,9 H 14"
                                                          Stroke="{StaticResource BluePrimaryBrush}" StrokeThickness="1.6"
                                                          Width="16" Height="16" Stretch="Uniform"
                                                          HorizontalAlignment="Center" />
                                                    <Path x:Name="chevron"
                                                          Data="M 0,0 L 4,4 L 8,0 Z"
                                                          Fill="{StaticResource BluePrimaryBrush}"
                                                          Width="8" Height="4" Stretch="Uniform"
                                                          Margin="0,2,0,0"
                                                          HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="iconBorder" Property="Background" Value="{StaticResource BlueTintBrush}" />
                                                    <Setter TargetName="icon" Property="Stroke" Value="{StaticResource BlueDeepBrush}" />
                                                    <Setter TargetName="chevron" Property="Fill" Value="{StaticResource BlueDeepBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- 禁用遮罩 -->
                                <Grid x:Name="PART_DisabledVisual" Grid.Column="0" Grid.ColumnSpan="2"
                                      Background="#33FFFFFF" Visibility="Collapsed" />
                                <!-- 日历浮层 -->
                                <Popup x:Name="PART_Popup"
                                       AllowsTransparency="True" Placement="Bottom" StaysOpen="False"
                                       PopupAnimation="Fade"
                                       IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="{StaticResource WhiteBrush}"
                                            BorderBrush="{StaticResource Gray200Brush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6"
                                            MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="0,4,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.22" Color="#111827" />
                                        </Border.Effect>
                                        <Calendar x:Name="PART_Calendar" />
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Error banner -->
            <Style x:Key="ErrorBannerStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Red50Brush}" />
                <Setter Property="BorderBrush" Value="{StaticResource Red200Brush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10,8" />
            </Style>

            <!-- Card -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource WhiteBrush}" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="24,20" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
