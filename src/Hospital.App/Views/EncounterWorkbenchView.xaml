<UserControl x:Class="Hospital.App.Views.EncounterWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Hospital.App.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="1200"
             FontFamily="Microsoft YaHei, SimHei, sans-serif">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,32">

            <!-- ===== Header ===== -->
            <Border Padding="32,28" CornerRadius="12">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0EA5E9" Offset="0.0" />
                        <GradientStop Color="#0284C7" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel>
                    <TextBlock FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource WhiteBrush}"
                               Text="门诊医生站" />
                    <TextBlock Margin="0,8,0,0" FontSize="14"
                               Foreground="{StaticResource BlueAccentBrush}"
                               Text="病历书写 · 诊断开立 · 处方开立 · 检验检查申请" />
                </StackPanel>
            </Border>

            <!-- ===== Error Banner ===== -->
            <Border Margin="0,16,0,0"
                    Style="{StaticResource ErrorBannerStyle}"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding ErrorMessage}"
                           FontSize="13" Foreground="{StaticResource Red700Brush}"
                           TextWrapping="Wrap" />
            </Border>

            <!-- ===== Selected Patient Info ===== -->
            <Border Margin="0,12,0,0" Padding="16,10" CornerRadius="6"
                    Background="{StaticResource BlueSubtleBrush}"
                    Visibility="{Binding SelectedPatientInfo, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource BluePrimaryBrush}"
                               Text="{Binding SelectedPatientInfo}" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="24,0,0,0">
                        <Button Content="开始接诊" Height="32" Padding="16,0" Margin="0,0,8,0"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding StartConsultationCommand}" />
                        <Button Content="完成接诊" Height="32" Padding="16,0"
                                FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding CompleteConsultationCommand}" />
                    </StackPanel>
                    <Button Grid.Column="3" Content="刷新队列" Height="32" Padding="12,0" Margin="12,0,0,0"
                            FontSize="13" Cursor="Hand"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding LoadQueueCommand}" />
                </Grid>
            </Border>

            <!-- ===== TabControl ===== -->
            <Border Margin="0,16,0,0" Padding="0" CornerRadius="10"
                    Background="{StaticResource WhiteBrush}">
                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                            Padding="0" Margin="0"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabControl.Resources>
                        <Style TargetType="TabPanel">
                            <Setter Property="Background" Value="{StaticResource Gray50Brush}" />
                        </Style>
                    </TabControl.Resources>

                    <!-- ===== Tab 1: 患者队列 ===== -->
                    <TabItem Header="① 患者队列">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="① 患者队列" FontSize="14" FontWeight="SemiBold" Padding="16,10" />
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Gray900Brush}"
                                           Text="{Binding QueueRows.Count, StringFormat='门诊队列（{0} 人）'}" />

                                <ItemsControl ItemsSource="{Binding QueueRows}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,10" Margin="0,0,0,4" CornerRadius="6"
                                                    Background="{StaticResource Gray50Brush}"
                                                    Cursor="Hand">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectPatientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                  CommandParameter="{Binding}" />
                                                </Border.InputBindings>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="18" FontWeight="Bold"
                                                               Foreground="{StaticResource BluePrimaryBrush}"
                                                               Text="{Binding QueueNumber, StringFormat='#{0}'}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Gray900Brush}"
                                                                   Text="{Binding PatientName}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{StaticResource Gray500Brush}"
                                                                       Text="{Binding PatientGender}" />
                                                            <TextBlock FontSize="11" Margin="8,0,0,0"
                                                                       Foreground="{StaticResource Gray500Brush}"
                                                                       Text="{Binding PatientIdCard}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource Gray500Brush}"
                                                                   Text="{Binding SlotName}" />
                                                    </StackPanel>
                                                    <!-- 状态徽标：待诊 / 就诊中 / 已呼叫（模拟） -->
                                                    <Border Grid.Column="3" Padding="8,4" CornerRadius="4"
                                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource BlueSubtleBrush}" />
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="待诊">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="就诊中">
                                                                        <Setter Property="Background" Value="{StaticResource Green200Brush}" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource Amber600Brush}" />
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BluePrimaryBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{Binding Status}" />
                                                                    <Setter Property="Foreground" Value="{StaticResource BluePrimaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="就诊中">
                                                                            <Setter Property="Foreground" Value="{StaticResource Green600Brush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsCalled}" Value="True">
                                                                            <Setter Property="Text" Value="已呼叫" />
                                                                            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <TextBlock Grid.Column="4" FontSize="12"
                                                               Foreground="{StaticResource Gray400Brush}"
                                                               Text="{Binding RegisterTime}"
                                                               VerticalAlignment="Center" Margin="0,0,12,0" />
                                                    <!-- 按就诊人操作：呼叫 / 开始接诊（待诊），完成接诊（就诊中） -->
                                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <ContentControl Margin="0,0,6,0">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="待诊">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <Button Content="呼叫" Height="28" Padding="12,0"
                                                                    FontSize="12" Cursor="Hand"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Command="{Binding DataContext.CallPatientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </ContentControl>
                                                        <ContentControl Margin="0,0,6,0">
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="待诊">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <Button Content="开始接诊" Height="28" Padding="12,0"
                                                                    FontSize="12" Cursor="Hand"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Command="{Binding DataContext.StartConsultationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </ContentControl>
                                                        <ContentControl>
                                                            <ContentControl.Style>
                                                                <Style TargetType="ContentControl">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="就诊中">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </ContentControl.Style>
                                                            <Button Content="完成接诊" Height="28" Padding="12,0"
                                                                    FontSize="12" Cursor="Hand"
                                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                                    Command="{Binding DataContext.CompleteConsultationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                    CommandParameter="{Binding}" />
                                                        </ContentControl>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Tab 2: 病历书写 ===== -->
                    <TabItem Header="② 病历书写">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="② 病历书写" FontSize="14" FontWeight="SemiBold" Padding="16,10" />
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" FontWeight="SemiBold"
                                               Foreground="{StaticResource Gray900Brush}"
                                               Text="病历书写" />
                                    <TextBlock Grid.Column="1" FontSize="13" Foreground="{StaticResource Gray500Brush}"
                                               Text="{Binding RecordStatusText, StringFormat='状态: {0}'}" />
                                </Grid>

                                <TextBlock Margin="0,16,0,0" Text="主诉" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource Gray700Brush}" />
                                <TextBox Margin="0,4,0,0" Height="36" Padding="8,0"
                                         Text="{Binding ChiefComplaint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource FormTextBoxStyle}" />

                                <TextBlock Margin="0,12,0,0" Text="现病史" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource Gray700Brush}" />
                                <TextBox Margin="0,4,0,0" Height="72" Padding="8,4"
                                         Text="{Binding PresentIllness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Style="{StaticResource FormTextBoxStyle}" />

                                <TextBlock Margin="0,12,0,0" Text="既往史" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource Gray700Brush}" />
                                <TextBox Margin="0,4,0,0" Height="60" Padding="8,4"
                                         Text="{Binding PastHistory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Style="{StaticResource FormTextBoxStyle}" />

                                <TextBlock Margin="0,12,0,0" Text="体格检查" FontSize="13" FontWeight="Medium"
                                           Foreground="{StaticResource Gray700Brush}" />
                                <TextBox Margin="0,4,0,0" Height="60" Padding="8,4"
                                         Text="{Binding PhysicalExam, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap"
                                         Style="{StaticResource FormTextBoxStyle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="保存草稿" Width="120" Height="36" Margin="0,0,12,0"
                                            FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Command="{Binding SaveMedicalRecordCommand}" />
                                    <Button Content="提交终稿" Width="120" Height="36"
                                            FontSize="14" FontWeight="SemiBold" Cursor="Hand"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Command="{Binding SubmitMedicalRecordCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Tab 3: 诊断开立 ===== -->
                    <TabItem Header="③ 诊断开立">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="③ 诊断开立" FontSize="14" FontWeight="SemiBold" Padding="16,10" />
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Gray900Brush}"
                                           Text="诊断列表" />

                                <ItemsControl ItemsSource="{Binding Diagnoses}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" Margin="0,0,0,4" CornerRadius="6"
                                                    Background="{StaticResource Gray50Brush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Padding="8,3" CornerRadius="4"
                                                            Background="{StaticResource BlueLightBrush}"
                                                            Margin="0,0,12,0">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource WhiteBrush}"
                                                                   Text="{Binding DiagnosisType}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Gray900Brush}"
                                                                   Text="{Binding Description}" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource Gray500Brush}"
                                                                   Text="{Binding IcdCode}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="删除" Width="60" Height="28"
                                                            FontSize="12" Cursor="Hand"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.RemoveDiagnosisCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Id}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="8"
                                        Background="{StaticResource Gray50Brush}">
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Gray900Brush}"
                                                   Text="新增诊断" />

                                        <TextBlock Margin="0,12,0,6" Style="{StaticResource FormLabelStyle}"
                                                   Text="常用诊断快捷选择（选一项，编码与描述自动填入）" />
                                        <ComboBox Height="36" MinWidth="360" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding IcdItems}"
                                                  SelectedItem="{Binding SelectedIcdItem, Mode=TwoWay}"
                                                  Tag="选择或输入常用诊断，编码自动填充">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BluePrimaryBrush}" />
                                                        <TextBlock Text=" - " Foreground="{StaticResource Gray400Brush}" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{StaticResource Gray500Brush}"
                                                   Text="或在下方直接输入诊断描述，ICD 编码会自动匹配填充；编码也可手动修改。" />

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="诊断类型"
                                                       FontSize="13" Foreground="{StaticResource Gray700Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Height="36" MinWidth="140"
                                                      ItemsSource="{Binding DiagnosisTypeOptions}"
                                                      SelectedItem="{Binding NewDiagnosisType, Mode=TwoWay}"
                                                      Margin="0,0,16,8" HorizontalAlignment="Left" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="ICD 编码"
                                                       FontSize="13" Foreground="{StaticResource Gray700Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,8" />
                                            <TextBox Grid.Row="0" Grid.Column="3" Height="36" Padding="8,0"
                                                     Text="{Binding NewIcdCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0,0,0,8" Tag="例：I10"
                                                     Style="{StaticResource WatermarkTextBoxStyle}" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="诊断描述"
                                                       FontSize="13" Foreground="{StaticResource Gray700Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="36"
                                                     Padding="8,0" Tag="例：高血压病 / 急性上呼吸道感染"
                                                     Text="{Binding NewDiagnosisDesc, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource WatermarkTextBoxStyle}" />
                                        </Grid>
                                        <Button Content="添加诊断" Width="120" Height="34" Margin="0,12,0,0"
                                                FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding AddDiagnosisCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Tab 4: 处方开立 ===== -->
                    <TabItem Header="④ 处方开立">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="④ 处方开立" FontSize="14" FontWeight="SemiBold" Padding="16,10" />
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Gray900Brush}"
                                           Text="已开处方" />

                                <ItemsControl ItemsSource="{Binding Prescriptions}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="14,10" Margin="0,0,0,6" CornerRadius="6"
                                                    Background="{StaticResource Gray50Brush}">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BluePrimaryBrush}"
                                                                   Text="{Binding Status}" Margin="0,0,12,0" />
                                                        <TextBlock Grid.Column="2" FontSize="12"
                                                                   Foreground="{StaticResource Gray400Brush}"
                                                                   Text="{Binding Id, StringFormat='处方 #{0}'}" />
                                                    </Grid>
                                                    <ItemsControl ItemsSource="{Binding Items}" Margin="0,6,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Padding="8,6" Margin="0,0,0,2" CornerRadius="4"
                                                                        Background="{StaticResource WhiteBrush}">
                                                                    <TextBlock FontSize="13"
                                                                               Foreground="{StaticResource Gray700Brush}">
                                                                        <Run Text="{Binding DrugName}" FontWeight="SemiBold" />
                                                                        <Run Text="{Binding Spec}" />
                                                                        <Run Text=" | " />
                                                                        <Run Text="{Binding Dosage}" />
                                                                        <Run Text="{Binding Freq}" />
                                                                        <Run Text=" | " />
                                                                        <Run Text="{Binding Qty, StringFormat='{}{0} 剂'}" />
                                                                    </TextBlock>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- New Prescription Form -->
                                <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="8"
                                        Background="{StaticResource Gray50Brush}">
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Gray900Brush}" Text="开立新处方" />

                                        <!-- 用法示例提示 -->
                                        <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="6"
                                                Background="{StaticResource BlueSubtleBrush}">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{StaticResource BluePrimaryBrush}" Text="用法示例" />
                                                <TextBlock Margin="0,2,0,0" FontSize="12"
                                                           Foreground="{StaticResource Gray700Brush}" TextWrapping="Wrap"
                                                           Text="阿莫西林胶囊 0.25g*24粒 胶囊剂 ｜ 用法：口服 BID 每日2次 ｜ 每次 1粒 ｜ 共 7 天 21 粒 ｜ 备注：饭后服用" />
                                            </StackPanel>
                                        </Border>

                                        <ItemsControl ItemsSource="{Binding NewPrescriptionItems}" Margin="0,12,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="12,10" Margin="0,0,0,10" CornerRadius="6"
                                                            Background="{StaticResource WhiteBrush}">
                                                        <StackPanel>
                                                            <!-- 行1：药品名称 / 规格 / 剂型 -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                    <TextBlock Text="药品名称（选药自动填规格/剂型）"
                                                                               Style="{StaticResource FormLabelStyle}" />
                                                                    <ComboBox Height="32"
                                                                              ItemsSource="{Binding DataContext.DrugOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              SelectedItem="{Binding SelectedDrug, Mode=TwoWay}"
                                                                              Tag="选择药品，自动填规格/剂型">
                                                                        <ComboBox.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <TextBlock Text="{Binding Converter={StaticResource DrugDisplayConverter}}"
                                                                                           ToolTip="{Binding Name}" />
                                                                            </DataTemplate>
                                                                        </ComboBox.ItemTemplate>
                                                                    </ComboBox>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="规格" Style="{StaticResource FormLabelStyle}" />
                                                                    <TextBox Height="32" Tag="例：0.25g*24粒"
                                                                             Text="{Binding Spec, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource WatermarkTextBoxStyle}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                                    <TextBlock Text="剂型" Style="{StaticResource FormLabelStyle}" />
                                                                    <TextBox Height="32" Tag="例：胶囊剂"
                                                                             Text="{Binding Form, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource WatermarkTextBoxStyle}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="3" Content="删除" Width="56" Height="30"
                                                                        FontSize="12" Cursor="Hand" VerticalAlignment="Bottom"
                                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                                        Command="{Binding DataContext.RemovePrescriptionItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}" />
                                                            </Grid>

                                                            <!-- 行2：用法频次 / 单次剂量 / 用药天数 / 总数量 -->
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                                    <TextBlock Text="用法频次" Style="{StaticResource FormLabelStyle}" />
                                                                    <ComboBox Height="32"
                                                                              ItemsSource="{Binding DataContext.FreqOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                              SelectedItem="{Binding SelectedFreq, Mode=TwoWay}"
                                                                              Tag="选择用法频次" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                    <TextBlock Text="单次剂量" Style="{StaticResource FormLabelStyle}" />
                                                                    <TextBox Height="32" Tag="例：1粒 或 0.25g"
                                                                             Text="{Binding Dosage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             Style="{StaticResource WatermarkTextBoxStyle}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                                                                    <TextBlock Text="用药天数" Style="{StaticResource FormLabelStyle}" />
                                                                    <TextBox Height="32" Tag="例：7"
                                                                             Text="{Binding Duration, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}"
                                                                             Style="{StaticResource WatermarkTextBoxStyle}" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3">
                                                                    <TextBlock Text="总数量（剂）" Style="{StaticResource FormLabelStyle}" />
                                                                    <TextBox Height="32" Tag="例：21"
                                                                             Text="{Binding Qty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, TargetNullValue=0}"
                                                                             Style="{StaticResource WatermarkTextBoxStyle}" />
                                                                </StackPanel>
                                                            </Grid>

                                                            <!-- 行3：备注 -->
                                                            <Grid Margin="0,10,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="备注" FontSize="12"
                                                                           Foreground="{StaticResource Gray700Brush}"
                                                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                <TextBox Grid.Column="1" Height="30" Padding="8,0" Tag="例：饭后服用，多饮水"
                                                                         Text="{Binding Note, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Style="{StaticResource WatermarkTextBoxStyle}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="+ 添加药品" Height="34" Padding="16,0" Margin="0,0,12,0"
                                                    FontSize="13" Cursor="Hand"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Command="{Binding AddPrescriptionItemCommand}" />
                                            <Button Content="开立处方" Width="120" Height="34"
                                                    FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Command="{Binding CreatePrescriptionCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- ===== Tab 5: 检验检查 ===== -->
                    <TabItem Header="⑤ 检验检查">
                        <TabItem.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="⑤ 检验检查" FontSize="14" FontWeight="SemiBold" Padding="16,10" />
                            </DataTemplate>
                        </TabItem.HeaderTemplate>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16">
                            <StackPanel>
                                <TextBlock FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource Gray900Brush}" Text="检验申请" />

                                <ItemsControl ItemsSource="{Binding LabOrders}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="12,8" Margin="0,0,0,4" CornerRadius="6"
                                                    Background="{StaticResource Gray50Brush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Gray900Brush}"
                                                                   Text="{Binding ItemName}" />
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource Gray500Brush}"
                                                                   Text="{Binding ItemCode}" />
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Padding="8,4" CornerRadius="4"
                                                            Background="{StaticResource BlueSubtleBrush}"
                                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BluePrimaryBrush}"
                                                                   Text="{Binding Status}" />
                                                    </Border>
                                                    <Button Grid.Column="2" Content="取消" Width="60" Height="28"
                                                            FontSize="12" Cursor="Hand"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Command="{Binding DataContext.CancelLabOrderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding Id}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Margin="0,16,0,0" Padding="16,14" CornerRadius="8"
                                        Background="{StaticResource Gray50Brush}">
                                    <StackPanel>
                                        <TextBlock FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Gray900Brush}" Text="新增检验申请" />

                                        <TextBlock Margin="0,12,0,6" Style="{StaticResource FormLabelStyle}"
                                                   Text="常用项目快捷开立（点一下即开立）" />
                                        <WrapPanel>
                                            <Button Content="血常规" Command="{Binding QuickAddLabCommand}" CommandParameter="CBC"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                            <Button Content="尿常规" Command="{Binding QuickAddLabCommand}" CommandParameter="UAN"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                            <Button Content="肝功能" Command="{Binding QuickAddLabCommand}" CommandParameter="LIVER_FUNC"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                            <Button Content="肾功能" Command="{Binding QuickAddLabCommand}" CommandParameter="RENAL"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                            <Button Content="空腹血糖" Command="{Binding QuickAddLabCommand}" CommandParameter="FBS"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                            <Button Content="心电图" Command="{Binding QuickAddLabCommand}" CommandParameter="ECG"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                            <Button Content="胸部X线检查" Command="{Binding QuickAddLabCommand}" CommandParameter="CHEST_XRAY"
                                                    Style="{StaticResource ChipButtonStyle}" Margin="0,0,8,8" />
                                        </WrapPanel>

                                        <TextBlock Margin="0,10,0,6" Style="{StaticResource FormLabelStyle}"
                                                   Text="或从常用项目中选择（编码与名称自动填入）" />
                                        <ComboBox Height="36" MinWidth="360" HorizontalAlignment="Left"
                                                  ItemsSource="{Binding LabItems}"
                                                  SelectedItem="{Binding SelectedLabItem, Mode=TwoWay}"
                                                  Tag="选择或输入常用检验项目，编码自动填充">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Code}" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource BluePrimaryBrush}" />
                                                        <TextBlock Text=" - " Foreground="{StaticResource Gray400Brush}" />
                                                        <TextBlock Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="项目编码" FontSize="13"
                                                       Foreground="{StaticResource Gray700Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="1" Height="36" Padding="8,0" Margin="0,0,16,0"
                                                     Text="{Binding NewLabItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="例：CBC" Style="{StaticResource WatermarkTextBoxStyle}" />
                                            <TextBlock Grid.Column="2" Text="项目名称" FontSize="13"
                                                       Foreground="{StaticResource Gray700Brush}"
                                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <TextBox Grid.Column="3" Height="36" Padding="8,0"
                                                     Text="{Binding NewLabItemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Tag="例：血常规" Style="{StaticResource WatermarkTextBoxStyle}" />
                                        </Grid>
                                        <TextBlock Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{StaticResource Gray500Brush}"
                                                   Text="也可手动输入编码与名称（编码留空仅填名称亦可）。" />
                                        <Button Content="添加申请" Width="120" Height="34" Margin="0,12,0,0"
                                                FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                                Style="{StaticResource PrimaryButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding AddLabOrderCommand}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                </TabControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
